# SITE_URL: The canonical public URL of this app (no trailing slash).
# Used at BUILD TIME by the prerender step for the sitemap.xml, robots.txt,
# per-page canonical tags, and JSON-LD structured data. Set it as an env var on
# your static host, or inline it: SITE_URL=https://www.totalcalculation.com npm run build
#
# The apex domain redirects to www, so www is the only host that serves the site;
# a production build normalises the apex to www and refuses any other origin, so a
# stale value (a *.vercel.app deployment URL, an old domain) fails the build rather
# than publishing the wrong host. With no SITE_URL set, the canonical origin is used.
SITE_URL="https://www.totalcalculation.com"

# VITE_GA4_ID: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Baked in at build time; when set, GA4 tracking is enabled client-side
# (page views on load and on every SPA navigation). Leave empty for dev.
VITE_GA4_ID="G-KDG2201RFZ"

# GOOGLE_SITE_VERIFICATION: Google Search Console verification token
# (the content value of the google-site-verification meta tag).
# Injected into every prerendered page at build time. Leave empty to skip.
GOOGLE_SITE_VERIFICATION=
